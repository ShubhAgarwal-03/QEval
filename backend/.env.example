# Gemini API key used by the Evaluator Service
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database connection string.
# SQLite for local dev (default), Postgres for staging/prod.
DATABASE_URL=sqlite:///./assessment.db
# DATABASE_URL=postgresql://user:password@localhost:5432/question_eval

# Path to the predefined question set loaded on startup
QUESTIONS_SEED_PATH=data/questions_seed.json

# Logging
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared secret required in the X-Admin-Key header to manage questions via
# /admin/questions. Leave unset to disable admin access entirely.
ADMIN_API_KEY=change-me-to-a-long-random-value